{
  "manifest_version": 3,
  "name": "XINSTA",
  "version": "2.1.0",
  "description": "Scroll X like Instagram Reels: one post per screen, centred, with snap scrolling and keyboard control.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "QUANTUM",
  "action": {
    "default_title": "XINSTA: Reels mode on or off (R)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}